<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.pixelcivilization.game">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="Pixel Civilization" android:icon="@drawable/island" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:hardwareAccelerated="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".IslandActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
