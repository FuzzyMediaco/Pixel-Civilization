{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-civilization",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "routes": [{ "pattern": "pixelcivilization.app", "custom_domain": true }],
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "PIX_BUDGET", "class_name": "PixBudget" }, { "name": "SHARED_ISLANDS", "class_name": "SharedIsland" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PixBudget"] }, { "tag": "v2", "new_sqlite_classes": ["SharedIsland"] }],
  "d1_databases": [{
    "binding": "GAME_ACCOUNTS",
    "database_name": "pixel-civilization-accounts",
    "database_id": "98601a49-3911-4f3a-b265-e572f58f255c",
    "migrations_dir": "migrations"
  }]
}
